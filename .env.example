# ===== ВКонтакте =====
# Токен сообщества: Управление → Работа с API → Ключи доступа (права: сообщения, управление)
VK_GROUP_TOKEN=vk1.a.ваш_токен_сообщества

# ===== ProxyAPI (OpenAI-совместимый endpoint) =====
PROXYAPI_KEY=sk-ваш_ключ_proxyapi
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# ===== Модель =====
# Полный идентификатор "вендор/модель" — см. https://proxyapi.ru/models/browse
AI_MODEL=openai/gpt-5-mini
# Резервные модели через запятую (используются, если основная недоступна). Можно оставить пустым.
AI_FALLBACK_MODELS=openai/gpt-4.1-mini
# Глубина рассуждений gpt-5-mini: minimal | low | medium | high (пусто — по умолчанию модели)
AI_REASONING_EFFORT=low
# Лимит токенов ответа (у reasoning-моделей сюда входят и «размышления»).
# Файлы (программы тренировок, планы) бывают объёмными — 8000 оставляет запас
AI_MAX_COMPLETION_TOKENS=8000
# Таймаут одного запроса к API, секунды
AI_TIMEOUT=90
# Число автоматических повторов SDK при 429/5xx/сетевых ошибках
AI_MAX_RETRIES=2

# ===== Память и диалоги =====
USERS_DIR=users
MAX_HISTORY_MESSAGES=100
# Ограничение размера контекста в символах (защита от переполнения контекстного окна)
MAX_CONTEXT_CHARS=60000
MAX_DIALOGS_PER_USER=30
DEFAULT_MODE=assistant

# ===== Ограничения сообщений =====
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHUNK_CHARS=4000

# ===== Логирование =====
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
